local function CreateESP(pl)
    local set={pl=pl}
    
    -- Box: Thin solid green
    set.box={}; for _=1,4 do table.insert(set.box,NLine(Color3.fromRGB(0, 255, 0), 1, 1)) end
    
    -- Health Bar: Dark background, gradient fill
    set.hpBG = NLine(Color3.fromRGB(20,20,20), 3, 1)
    set.hpFill = NLine(Color3.fromRGB(0, 255, 0), 2, 1)
    
    -- Skeleton: Thin white lines
    set.skel={}; for _=1,15 do table.insert(set.skel,NLine(Color3.fromRGB(255, 255, 255), 1, 0.8)) end
    
    -- Head Circle: Thin white outline
    set.headDot = ND("Circle", {Visible=false, Color=Color3.fromRGB(255, 255, 255), Thickness=1, Filled=false, Radius=10, Transparency=0.1})
    
    -- Text: White with black outline
    set.name = ND("Text",{Visible=false,Color=Color3.fromRGB(255, 255, 255),Size=13,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0), Font=2})
    set.tool = ND("Text",{Visible=false,Color=Color3.fromRGB(200, 200, 200),Size=11,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0), Font=2})
    
    -- Snapline: Clean thin line from bottom
    set.snap=NLine(Color3.fromRGB(0, 255, 0),1,0.8)
    
    set.lastVisCheck = 0
    set.cachedVis = true
    State.ESPSets[pl]=set; return set
end

local function HideESP(set)
    for _,l in ipairs(set.box) do l.Visible=false end
    for _,l in ipairs(set.skel) do l.Visible=false end
    set.hpBG.Visible=false; set.hpFill.Visible=false
    set.name.Visible=false; set.tool.Visible=false
    set.headDot.Visible=false; set.snap.Visible=false
end

local function DestroyESP(pl)
    local set=State.ESPSets[pl]; if not set then return end
    for k,v in pairs(set) do
        if k=="pl" or k=="lastVisCheck" or k=="cachedVis" then continue end
        if type(v)=="table" then for _,d in ipairs(v) do pcall(function() d:Remove() end) end
        else pcall(function() v:Remove() end) end
    end
    State.ESPSets[pl]=nil
end

local function UpdateChams(pl)
    local hl=State.Highlights[pl]
    local char = pl.Character
    
    if not F.ChamsOn or not IsAlive(pl) or not char then 
        if hl and hl.Enabled then hl.Enabled=false end
        return 
    end
    
    local enemy=IsEnemy(pl)
    local fillCol, outlineCol
    
    if F.ChamsTheme == "Enemy/Team" then
        fillCol = enemy and Color3.fromRGB(210,50,50) or TH.AccentR
        outlineCol = fillCol
    elseif F.ChamsTheme == "Solid Green" then
        fillCol = Color3.fromRGB(0, 255, 0)
        outlineCol = Color3.fromRGB(0, 255, 0)
    elseif F.ChamsTheme == "Green & White" then
        fillCol = Color3.fromRGB(0, 255, 0)
        outlineCol = Color3.fromRGB(255, 255, 255)
    end
    
    if not hl or not hl.Parent or hl.Adornee ~= char then
        if hl then hl:Destroy() end
        hl=Instance.new("Highlight")
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor=fillCol
        hl.FillTransparency=F.ChamsFill
        hl.OutlineColor=outlineCol
        hl.OutlineTransparency=0.12
        hl.Adornee=char
        hl.Parent=workspace
        State.Highlights[pl]=hl
    end
    
    if hl.FillTransparency ~= F.ChamsFill then hl.FillTransparency = F.ChamsFill end
    if hl.FillColor ~= fillCol then hl.FillColor = fillCol end
    if hl.OutlineColor ~= outlineCol then hl.OutlineColor = outlineCol end
    
    hl.Enabled=true
end

