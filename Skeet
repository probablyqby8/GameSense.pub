local function MakeGradBar(parentInner, zi)
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1,0,0,2)
    bar.BorderSizePixel = 0; bar.ZIndex = (zi or 2); bar.Parent = parentInner
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, TH.AccentL),
        ColorSequenceKeypoint.new(1, TH.AccentR),
    })
    g.Parent = bar; return bar
end

local function MakeDraggable(topbar, window)
    local drag, ds, sp = false, nil, nil
    topbar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; ds = i.Position; sp = window.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    topbar.InputChanged:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if drag then
            local d = i.Position - ds
            window.Position = UDim2.new(sp.X.Scale, sp.X.Offset+d.X, sp.Y.Scale, sp.Y.Offset+d.Y)
        end
    end)
end

