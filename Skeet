local function IsEnemy(pl)
    if pl == LP then return false end
    if LP.Team and pl.Team then return pl.Team ~= LP.Team end
    return true
end

local function WallBlocked(origin, target, ignore)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = ignore or {}
    local r = workspace:Raycast(origin, target - origin, p)
    if not r then return false end
    local m = r.Instance:FindFirstAncestorOfClass("Model")
    return not (m and m:FindFirstChildOfClass("Humanoid"))
end

