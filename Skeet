RunService:BindToRenderStep("GS_Render",Enum.RenderPriority.Camera.Value+2,function(dt)
    if State.Destroyed then return end
    local vp=Camera.ViewportSize; local vc=Vector2.new(vp.X/2,vp.Y/2)
    State.FPS=State.FPS*0.92+(1/math.max(dt,1e-6))*0.08
    
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and not State.BindingCapture then
        State.LastFire = tick()
    end

    if F.Watermark then
        local okp, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        State.Ping = okp and ping or 0
        local elapsed = math.floor(tick() - State.StartTime)
        local m,s = math.floor(elapsed/60), elapsed%60
        local kstr = F.MenuKeyUIT and tostring(F.MenuKey):gsub("Enum%..*%.","")
                                    or tostring(F.MenuKey):gsub("Enum%.KeyCode%.","")
        WMText.Text=string.format("gamesense.pub  |  %s  |  %dfps  |  %dms  |  %02d:%02d  |  [%s]",
            LP.Name, math.floor(State.FPS+0.5), math.floor(State.Ping), m, s, kstr)
        WM.Visible = true
    else
        WM.Visible = false
    end

    local hum=GetHum()
    if hum then
        if F.SpeedOn then hum.WalkSpeed=F.SpeedVal end
        if F.JumpOn then
            if hum.UseJumpPower then hum.JumpPower=F.JumpVal else hum.JumpHeight=F.JumpVal*0.4 end
        end
    end

    for _,pl in ipairs(Players:GetPlayers()) do
        if pl~=LP then UpdateChams(pl) end
    end

    if F.Fly and not State.BindingCapture then UpdateFly() end

    abFOV.Visible = F.AimbotOn and F.AimbotFOVCirc
    abFOV.Position = vc
    abFOV.Radius = F.AimbotFOV
    
    if F.AimbotMode=="Toggle" and State.AimbotToggle then
        abFOV.Color = TH.AccentL
        abFOV.Transparency = 0.25
    elseif F.AimbotMode=="Hold" and IsAimbotHeld() then
        abFOV.Color = TH.AccentL
        abFOV.Transparency = 0.25
    else
        abFOV.Color = TH.AccentL
        abFOV.Transparency = 0.75
    end
    tbFOV.Visible=F.TriggerOn; tbFOV.Position=vc; tbFOV.Radius=F.TriggerFOV

    local showTgl = F.AimbotOn and F.AimbotTglInd
    toggleLbl.Visible = showTgl
    if showTgl then
        local stateStr = ""
        if F.AimbotMode == "Hold" then
            local held = IsAimbotHeld()
            stateStr = held and "◆ AIMBOT ACTIVE" or "◇ AIMBOT IDLE (HOLD)"
            toggleLbl.Color = held and TH.AccentL or TH.TextMuted
        elseif F.AimbotMode == "Toggle" then
            stateStr = State.AimbotToggle and "◆ AIMBOT ACTIVE" or "◇ AIMBOT IDLE (TOGGLE)"
            toggleLbl.Color = State.AimbotToggle and TH.AccentL or TH.TextMuted
        else
            stateStr = "◆ AIMBOT ACTIVE (ALWAYS)"
            toggleLbl.Color = TH.AccentL
        end
        toggleLbl.Text = stateStr
        toggleLbl.Position = Vector2.new(vc.X, vc.Y + F.AimbotFOV + 14)
        toggleLbl.Size = 14
    end

    if F.Crosshair then
        local g,L=F.CHGap,F.CHLen
        chLines[1].From=Vector2.new(vc.X-g-L,vc.Y); chLines[1].To=Vector2.new(vc.X-g,vc.Y)
        chLines[2].From=Vector2.new(vc.X+g,vc.Y);   chLines[2].To=Vector2.new(vc.X+g+L,vc.Y)
        chLines[3].From=Vector2.new(vc.X,vc.Y-g-L); chLines[3].To=Vector2.new(vc.X,vc.Y-g)
        chLines[4].From=Vector2.new(vc.X,vc.Y+g);   chLines[4].To=Vector2.new(vc.X,vc.Y+g+L)
        for _,l in ipairs(chLines) do l.Visible=true end
    else
        for _,l in ipairs(chLines) do l.Visible=false end
    end

    if tick() - State.HitMarkerTime < 0.2 then
        local gap = 6
        local len = 6
        hmLines[1].From = Vector2.new(vc.X - gap - len, vc.Y - gap - len); hmLines[1].To = Vector2.new(vc.X - gap, vc.Y - gap)
        hmLines[2].From = Vector2.new(vc.X + gap, vc.Y - gap); hmLines[2].To = Vector2.new(vc.X + gap + len, vc.Y - gap - len)
        hmLines[3].From = Vector2.new(vc.X - gap - len, vc.Y + gap + len); hmLines[3].To = Vector2.new(vc.X - gap, vc.Y + gap)
        hmLines[4].From = Vector2.new(vc.X + gap, vc.Y + gap); hmLines[4].To = Vector2.new(vc.X + gap + len, vc.Y + gap + len)
        for _,l in ipairs(hmLines) do l.Visible = true end
    else
        for _,l in ipairs(hmLines) do l.Visible = false end
    end

    -- ================= AIMBOT =================
    if IsAimbotActive() and not State.BindingCapture then
        local tp, part = GetAimbotTarget()
        if tp then
            State.LockedTarget = tp
            State.LockedPart   = part

            local cf = Camera.CFrame
            local desired = CFrame.lookAt(cf.Position, tp)
            
            if F.AimbotMethod == "Camera" then
                if F.AimbotSmooth <= 1 then
                    Camera.CFrame = desired
                else
                    local k = 20 / math.max(F.AimbotSmooth, 1.1)
                    local alpha = math.clamp(1 - math.exp(-k * dt), 0, 1)
                    Camera.CFrame = cf:Lerp(desired, alpha)
                end
            elseif F.AimbotMethod == "Mouse" then
                local sp, vis = Camera:WorldToViewportPoint(tp)
                if vis then
                    local delta = Vector2.new(sp.X, sp.Y) - vc
                    if delta.Magnitude > 1 then
                        local moveX = delta.X / F.AimbotSmooth
                        local moveY = delta.Y / F.AimbotSmooth
                        if type(mousemoverel) == "function" then
                            mousemoverel(moveX, moveY)
                        elseif type(VIM) == "userdata" then
                            local cur = UserInputService:GetMouseLocation()
                            VIM:SendMouseMoveEvent(cur.X + moveX, cur.Y + moveY, game)
                        end
                    end
                end
            end
        else
            State.LockedTarget = nil
            State.LockedPart = nil
        end
    else
        State.LockedTarget = nil
        State.LockedPart = nil
    end

    if F.AimbotShowLock and State.LockedTarget then
        local sp,vis = Camera:WorldToViewportPoint(State.LockedTarget)
        if vis then
            lockDot.Position = Vector2.new(sp.X, sp.Y); lockDot.Visible = true
            lockLine.From = vc; lockLine.To = Vector2.new(sp.X, sp.Y); lockLine.Visible = true
        else
            lockDot.Visible=false; lockLine.Visible=false
        end
    else
        lockDot.Visible=false; lockLine.Visible=false
    end

    -- ================= TRIGGERBOT =================
    if F.TriggerOn and not State.BindingCapture then State.TriggerAccum=State.TriggerAccum+dt else State.TriggerAccum=0 end
    if F.TriggerOn and not State.BindingCapture and State.TriggerAccum>=1/30 then
        State.TriggerAccum=0
        local holding=UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        local found=false
        if not holding then
            for _,pl in ipairs(Players:GetPlayers()) do
                if pl==LP then continue end
                if not IsEnemy(pl) then continue end
                if not IsAlive(pl) then continue end
                local char=pl.Character; if not char then continue end
                local h2=char:FindFirstChildOfClass("Humanoid")
                if not h2 or h2.Health<=0 then continue end
                for _,pn in ipairs(TRIGGER_PARTS) do
                    local part=char:FindFirstChild(pn); if not part then continue end
                    local sp,vis=Camera:WorldToViewportPoint(part.Position)
                    if not vis then continue end
                    if (Vector2.new(sp.X,sp.Y)-vc).Magnitude<=F.TriggerFOV then
                        if F.TriggerWall then
                            if WallBlocked(Camera.CFrame.Position,part.Position,{LP.Character,char}) then continue end
                        end
                        found=true; break
                    end
                end
                if found then break end
            end
        end
        local now=tick()
        local ok=(now-State.LastTriggerFire)>=F.TriggerDelay/1000
        if found and not State.TriggerFiring and not State.TriggerPending and ok then
            State.TriggerPending=true
            State.LastTriggerFire=now
            task.delay(F.TriggerDelay/1000,function()
                State.TriggerPending=false
                if State.Destroyed or not F.TriggerOn then return end
                if M1Press() then
                    State.TriggerFiring=true
                    task.delay(0.05,function()
                        if State.Destroyed then return end
                        M1Release(); State.TriggerFiring=false
                    end)
                end
            end)
        elseif not found and State.TriggerFiring then
            M1Release(); State.TriggerFiring=false
        end
    end
end)
table.insert(State.RenderSteps,"GS_Render")

-- ====================================================================
-- PERFECT ESP LOOP (60 FPS Smooth, No Lag, No Freezing)
-- ====================================================================
RunService.RenderStepped:Connect(function(dt)
    if State.Destroyed then return end
    
    -- We update ESP every frame for maximum smoothness, but we cache the wall check.
    if not F.ESPOn or not State.Authenticated then
        for _, set in pairs(State.ESPSets) do HideESP(set) end
        return
    end

    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LP then continue end
        local set=State.ESPSets[pl] or CreateESP(pl)

        if not IsAlive(pl) then HideESP(set); continue end
        local char=pl.Character; if not char then HideESP(set); continue end
        local hum2=char:FindFirstChildOfClass("Humanoid")
        if not hum2 or hum2.Health<=0 then HideESP(set); continue end
        local root=char:FindFirstChild("HumanoidRootPart")
        local head=char:FindFirstChild("Head")
        if not root or not head then HideESP(set); continue end

        local myRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local dist=myRoot and (root.Position-myRoot.Position).Magnitude or 0
        if F.ESPMaxDist>0 and dist>F.ESPMaxDist then HideESP(set); continue end

        local tS, tOK = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local bS, bOK = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))
        
        if not (tOK and bOK) then HideESP(set); continue end

        local now = tick()
        if (now - set.lastVisCheck > 0.2) then
            set.lastVisCheck = now
            set.cachedVis = not WallBlocked(Camera.CFrame.Position, head.Position, {LP.Character,char})
        end
        local visible = set.cachedVis

        -- 1. Box
        local ty = tS.Y
        local by = bS.Y
        local h = math.abs(by - ty)
        local w = h * 0.45
        local cx = (tS.X + bS.X) / 2
        local lx = cx - w / 2
        local rx = cx + w / 2
        
        if F.ESPBoxes then
            set.box[1].From = Vector2.new(lx, ty); set.box[1].To = Vector2.new(rx, ty); set.box[1].Visible = true
            set.box[2].From = Vector2.new(rx, ty); set.box[2].To = Vector2.new(rx, by); set.box[2].Visible = true
            set.box[3].From = Vector2.new(rx, by); set.box[3].To = Vector2.new(lx, by); set.box[3].Visible = true
            set.box[4].From = Vector2.new(lx, by); set.box[4].To = Vector2.new(lx, ty); set.box[4].Visible = true
        else
            for _,l in ipairs(set.box) do l.Visible = false end
        end

        -- 2. Health Bar
        if F.ESPHealth then
            local hp = math.clamp(hum2.Health / hum2.MaxHealth, 0, 1)
            local hpY = by - (h * hp)
            
            -- Premium Health Color Gradient
            local hpColor = Color3.fromRGB(255, 255, 255)
            if hp > 0.5 then
                hpColor = Color3.fromRGB(0, 255, 0):Lerp(Color3.fromRGB(255, 255, 0), (1 - hp) * 2)
            else
                hpColor = Color3.fromRGB(255, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), (0.5 - hp) * 2)
            end
            
            set.hpFill.Color = hpColor
            set.hpBG.From = Vector2.new(lx - 5, ty); set.hpBG.To = Vector2.new(lx - 5, by); set.hpBG.Visible = true
            set.hpFill.From = Vector2.new(lx - 5, hpY); set.hpFill.To = Vector2.new(lx - 5, by); set.hpFill.Visible = true
        else
            set.hpBG.Visible = false; set.hpFill.Visible = false
        end

        -- 3. Skeleton
        if F.ESPSkel then
            local headScreen, headVis = Camera:WorldToViewportPoint(head.Position)
            if headVis then
                set.headDot.Position = Vector2.new(headScreen.X, headScreen.Y)
                -- Dynamic circle size based on distance
                local rSize = math.clamp(dist * 0.12, 3, 14)
                set.headDot.Radius = rSize
                set.headDot.Visible = true
            else
                set.headDot.Visible = false
            end
            
            local isR15 = char:FindFirstChild("UpperTorso") ~= nil
            local bones = isR15 and SKEL_R15 or SKEL_R6
            for i, pair in ipairs(bones) do
                local p1 = char:FindFirstChild(pair[1])
                local p2 = char:FindFirstChild(pair[2])
                if p1 and p2 then
                    local s1, v1 = Camera:WorldToViewportPoint(p1.Position)
                    local s2, v2 = Camera:WorldToViewportPoint(p2.Position)
                    if v1 and v2 then
                        set.skel[i].From = Vector2.new(s1.X, s1.Y)
                        set.skel[i].To = Vector2.new(s2.X, s2.Y)
                        set.skel[i].Visible = true
                    else
                        set.skel[i].Visible = false
                    end
                else
                    set.skel[i].Visible = false
                end
            end
            for i = #bones + 1, #set.skel do set.skel[i].Visible = false end
        else
            for _,l in ipairs(set.skel) do l.Visible = false end
            set.headDot.Visible = false
        end

        -- 4. Name
        if F.ESPName then
            set.name.Text = pl.Name
            set.name.Position = Vector2.new(cx, ty - 16)
            set.name.Visible = true
        else
            set.name.Visible = false
        end

        -- 5. Tool
        if F.ESPTool then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                set.tool.Text = tool.Name
                set.tool.Position = Vector2.new(cx, by + 4)
                set.tool.Visible = true
            else
                set.tool.Visible = false
            end
        else
            set.tool.Visible = false
        end

        -- 6. Snapline
        if F.ESPSnapline then
            local sp = Camera:WorldToViewportPoint(head.Position)
            set.snap.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            set.snap.To = Vector2.new(sp.X, sp.Y)
            set.snap.Visible = true
        else
            set.snap.Visible = false
        end
    end
end)

