    function Tab:Slider(name, min, max, default, callback)
        local val=default or min; local range=math.max(max-min,1)
        local SliderFrame=Instance.new("Frame"); SliderFrame.Size=UDim2.new(1,0,0,30)
        SliderFrame.BackgroundTransparency=1; SliderFrame.Parent=Page

        local Lbl=Instance.new("TextLabel"); Lbl.Size=UDim2.new(1,0,0,14); Lbl.BackgroundTransparency=1
        Lbl.Text=name.." : "..tostring(val); Lbl.TextColor3=TH.Text; Lbl.Font=TH.Font
        Lbl.TextSize=11; Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.Parent=SliderFrame

        local TrackWrap=Instance.new("Frame"); TrackWrap.Size=UDim2.new(1,0,0,7); TrackWrap.Position=UDim2.new(0,0,0,17)
        TrackWrap.BackgroundColor3=TH.BG; TrackWrap.BorderSizePixel=0; TrackWrap.Parent=SliderFrame
        local trackInner=MakeBorders(TrackWrap)

        local Fill=Instance.new("Frame"); local a0=math.clamp((val-min)/range,0,1)
        Fill.Size=UDim2.new(a0,0,1,0); Fill.BorderSizePixel=0; Fill.Parent=trackInner
        local sfg=Instance.new("UIGradient"); sfg.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,TH.AccentL),ColorSequenceKeypoint.new(1,TH.AccentR)}); sfg.Parent=Fill

        local function SetVal(v,fire)
            val=math.clamp(v,min,max); local a=(val-min)/range
            Fill.Size=UDim2.new(a,0,1,0); Lbl.Text=name.." : "..tostring(math.floor(val))
            if fire and callback then callback(math.floor(val)) end
        end

        local sliding=false
        TrackWrap.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=true end end)
        SaveConn(UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 and sliding then PlayClick(); sliding=false end
        end))
        SaveConn(UserInputService.InputChanged:Connect(function(i)
            if State.Destroyed or not sliding then return end
            if i.UserInputType==Enum.UserInputType.MouseMovement then
                local rel=math.clamp(i.Position.X-TrackWrap.AbsolutePosition.X,0,TrackWrap.AbsoluteSize.X)
                SetVal(min+(max-min)*(rel/TrackWrap.AbsoluteSize.X),true)
            end
        end))
        SetVal(val,false)
        return {Get=function() return val end, Set=function(v) SetVal(v,false) end}
    end

    function Tab:Dropdown(name, opts, default, callback)
        local sel = default or opts[1]
        local Row = Instance.new("Frame"); Row.Size = UDim2.new(1,0,0,20); Row.BackgroundTransparency = 1; Row.Parent = Page

        local Lbl = Instance.new("TextLabel"); Lbl.Size = UDim2.new(0.5,0,1,0); Lbl.BackgroundTransparency = 1
        Lbl.Text = name; Lbl.TextColor3 = TH.Text; Lbl.Font = TH.Font; Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left; Lbl.Parent = Row

        local DDWrap = Instance.new("Frame"); DDWrap.Size = UDim2.new(0.5,-4,0,16); DDWrap.Position = UDim2.new(0.5,0,0.5,-8)
        DDWrap.BackgroundColor3 = TH.BG; DDWrap.BorderSizePixel = 0; DDWrap.Parent = Row
        local ddInner = MakeBorders(DDWrap)

        local DDBtn = Instance.new("TextButton"); DDBtn.Size = UDim2.new(1,0,1,0); DDBtn.BackgroundTransparency = 1
        DDBtn.Text = sel.."  ▾"; DDBtn.TextColor3 = TH.TextHi; DDBtn.Font = TH.Font; DDBtn.TextSize = 10; DDBtn.Parent = ddInner

        -- FIXED: Parented to DropdownGui for absolute top-level layering
        local DL = Instance.new("Frame"); DL.BackgroundColor3 = TH.BG; DL.BorderSizePixel = 0
        DL.ZIndex = 10; DL.Visible = false; DL.Parent = DropdownGui; MakeBorders(DL)
        DL.Inner.ZIndex = 10

        local DLL = Instance.new("UIListLayout"); DLL.SortOrder = Enum.SortOrder.LayoutOrder; DLL.Parent = DL

        local OPEN = false; local obs = {}
        for i, opt in ipairs(opts) do
            local OB = Instance.new("TextButton"); OB.Size = UDim2.new(1,0,0,20)
            OB.BackgroundColor3 = TH.Section; OB.BackgroundTransparency = 0; OB.BorderSizePixel = 0
            OB.Text = opt; OB.ZIndex = 11
            OB.TextColor3 = (opt==sel) and TH.TextHi or TH.Text; OB.Font = TH.Font; OB.TextSize = 10
            
            OB.MouseEnter:Connect(function() OB.BackgroundColor3 = TH.Input end)
            OB.MouseLeave:Connect(function() OB.BackgroundColor3 = TH.Section end)
            
            OB.LayoutOrder = i; OB.Parent = DL; table.insert(obs, OB)
            
            OB.MouseButton1Click:Connect(function()
                PlayClick(); sel = opt; DDBtn.Text = opt.."  ▾"
                for _, b in ipairs(obs) do b.TextColor3 = (b.Text==sel) and TH.TextHi or TH.Text end
                OPEN = false; DL.Visible = false
                if callback then callback(opt) end
            end)
        end

        local function Open()
            OPEN = true
            local abs = DDWrap.AbsolutePosition
            local sz = DDWrap.AbsoluteSize
            local totalH = #opts * 20
            
            DL.Size = UDim2.fromOffset(math.max(sz.X, 100), totalH)
            
            if abs.Y + sz.Y + totalH > Camera.ViewportSize.Y - 40 then
                DL.Position = UDim2.fromOffset(abs.X, abs.Y - totalH - 2)
            else
                DL.Position = UDim2.fromOffset(abs.X, abs.Y + sz.Y + 2)
            end
            DL.Visible = true
        end
        local function Close() OPEN = false; DL.Visible = false end

        DDBtn.MouseButton1Click:Connect(function() PlayClick(); if OPEN then Close() else Open() end end)
        
        SaveConn(UserInputService.InputBegan:Connect(function(i, gpe)
            if gpe then return end
            if State.Destroyed or not OPEN then return end
            if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            
            local m = i.Position
            local lA, lS = DL.AbsolutePosition, DL.AbsoluteSize
            local bA, bS = DDBtn.AbsolutePosition, DDBtn.AbsoluteSize
            
            local inList = m.X >= lA.X and m.X <= lA.X + lS.X and m.Y >= lA.Y and m.Y <= lA.Y + lS.Y
            local inBtn = m.X >= bA.X and m.X <= bA.X + bS.X and m.Y >= bA.Y and m.Y <= bA.Y + bS.Y
            
            if not inList and not inBtn then Close() end
        end))
        
        return {Get=function() return sel end}
    end

    function Tab:Keybind(name, defaultKey, isUIT, callback)
        local ck,cu=defaultKey,isUIT; local lst=false; local cap
        local Row=Instance.new("Frame"); Row.Size=UDim2.new(1,0,0,15); Row.BackgroundTransparency=1; Row.Parent=Page

        local Lbl=Instance.new("TextLabel"); Lbl.Size=UDim2.new(0.6,0,1,0); Lbl.BackgroundTransparency=1
        Lbl.Text=name; Lbl.TextColor3=TH.Text; Lbl.Font=TH.Font; Lbl.TextSize=11
        Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.Parent=Row

        local function KN(k) return tostring(k):gsub("Enum%.UserInputType%.",""):gsub("Enum%.KeyCode%.","") end

        local KBWrap=Instance.new("Frame"); KBWrap.Size=UDim2.new(0.4,-4,0,13); KBWrap.Position=UDim2.new(0.6,0,0.5,-6.5)
        KBWrap.BackgroundColor3=TH.BG; KBWrap.BorderSizePixel=0; KBWrap.Parent=Row
        local kbInner=MakeBorders(KBWrap)

        local KBBtn=Instance.new("TextButton"); KBBtn.Size=UDim2.new(1,0,1,0); KBBtn.BackgroundTransparency=1
        KBBtn.Text=KN(ck); KBBtn.TextColor3=TH.AccentL; KBBtn.Font=TH.Font; KBBtn.TextSize=10; KBBtn.Parent=kbInner

        local function Stop()
            lst=false; KBBtn.Text=KN(ck); KBBtn.TextColor3=TH.AccentL
            State.BindingCapture = false
            if cap then pcall(function() cap:Disconnect() end); cap=nil end
        end

        KBBtn.MouseButton1Click:Connect(function()
            PlayClick(); if lst then Stop(); return end
            lst=true; KBBtn.Text="[...]"; KBBtn.TextColor3=TH.TextMuted
            State.BindingCapture = true
            
            local clickCancel
            clickCancel = UserInputService.InputBegan:Connect(function(i,g)
                if not lst then return end
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    local m = i.Position
                    local bA, bS = KBBtn.AbsolutePosition, KBBtn.AbsoluteSize
                    if not (m.X >= bA.X and m.X <= bA.X+bS.X and m.Y >= bA.Y and m.Y <= bA.Y+bS.Y) then
                        Stop()
                        pcall(function() clickCancel:Disconnect() end)
                    end
                end
            end)
            table.insert(State.Connections, clickCancel)

            cap=UserInputService.InputBegan:Connect(function(i,g)
                if not lst or g then return end
                if i.UserInputType==Enum.UserInputType.Keyboard then
                    if i.KeyCode==Enum.KeyCode.Escape then Stop(); return end
                    ck=i.KeyCode; cu=false
                elseif i.UserInputType==Enum.UserInputType.MouseButton2 or i.UserInputType==Enum.UserInputType.MouseButton3 then
                    ck=i.UserInputType; cu=true
                else return end
                Stop(); if callback then callback(ck,cu) end
            end)
        end)
        return {Get=function() return ck,cu end}
    end

    function Tab:Button(name, callback)
        local BFrame=Instance.new("Frame"); BFrame.Size=UDim2.new(1,0,0,20)
        BFrame.BackgroundColor3=TH.BG; BFrame.BorderSizePixel=0; BFrame.Parent=Page
        local bInner=MakeBorders(BFrame)

        local Btn=Instance.new("TextButton"); Btn.Size=UDim2.new(1,0,1,0); Btn.BackgroundTransparency=1
        Btn.Text=name; Btn.TextColor3=TH.Text; Btn.Font=TH.Font; Btn.TextSize=11; Btn.Parent=bInner

        Btn.MouseEnter:Connect(function() Btn.TextColor3=TH.TextHi end)
        Btn.MouseLeave:Connect(function() Btn.TextColor3=TH.Text end)
        Btn.MouseButton1Click:Connect(function()
            PlayClick(); Btn.TextColor3=TH.AccentL
            task.delay(0.15,function() Btn.TextColor3=TH.Text end)
            if callback then callback() end
        end)
    end

    function Tab:Label(text, col)
        local L=Instance.new("TextLabel"); L.Size=UDim2.new(1,0,0,13); L.BackgroundTransparency=1
