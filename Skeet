-- ====================================================================
-- AIMBOT TARGETING
-- ====================================================================
local function PredictPos(part)
    if F.AimbotPredict<=0 then return part.Position end
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 2 then return part.Position end
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    local travel = dist / 250
    return part.Position + vel * travel * F.AimbotPredict
end

local function GetAimbotTarget()
    local ref = UserInputService:GetMouseLocation() - GuiInset()
    local bestDist = F.AimbotFOV
    local bestPos = nil
    local bestPart = nil
    local bestScore = -math.huge

    if F.AimbotSticky and State.LockedTarget and State.LockedPart then
        local char = State.LockedPart.Parent
        if char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
            local sp, vis = Camera:WorldToViewportPoint(State.LockedTarget)
            if vis then
                local d = (Vector2.new(sp.X, sp.Y) - ref).Magnitude
                if d <= F.AimbotFOV then
                    local pl = Players:GetPlayerFromCharacter(char)
                    if pl and IsEnemy(pl) then
                        local wallCheck = F.AimbotWall and WallBlocked(Camera.CFrame.Position, State.LockedPart.Position, {LP.Character, char})
                        if not wallCheck then
                            return State.LockedTarget, State.LockedPart
                        end
                    end
                end
            end
        end
    end

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        if F.AimbotTeam and not IsEnemy(pl) then continue end
        if not IsAlive(pl) then continue end
        local char = pl.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local part = char:FindFirstChild(F.AimbotHitbox) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local aimPos = PredictPos(part)
        local sp, vis = Camera:WorldToViewportPoint(aimPos)
        if not vis then continue end

        local d = (Vector2.new(sp.X, sp.Y) - ref).Magnitude
        if d >= bestDist then continue end

        if F.AimbotWall and WallBlocked(Camera.CFrame.Position, part.Position, {LP.Character, char}) then continue end

        local score
        if F.AimbotPriority == "Lowest HP" then
            score = -hum.Health
        elseif F.AimbotPriority == "Farthest" then
            score = d
        else
            score = -d
        end

        if score > bestScore then
            bestScore = score
            bestDist = d
            bestPos = aimPos
            bestPart = part
        end
    end
    return bestPos, bestPart
end

local function IsAimbotHeld()
    if F.AimbotKeyUIT then return UserInputService:IsMouseButtonPressed(F.AimbotKey)
    else return UserInputService:IsKeyDown(F.AimbotKey) end
end

local function IsAimbotActive()
    if not F.AimbotOn then return false end
    if F.AimbotMode=="Hold"   then return IsAimbotHeld() end
    if F.AimbotMode=="Toggle" then return State.AimbotToggle end
    if F.AimbotMode=="Always" then return true end
    return false
end

