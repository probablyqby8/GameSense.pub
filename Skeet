local POOL_N = 4
local function MakePool(id, vol)
    local pool = {}
    for i = 1, POOL_N do
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = vol or 0.5
        s.Parent = SoundService
        pool[i] = s
    end
    return pool
end

local HitPool   = MakePool("94204395881101", 0.7)
local ClickPool = MakePool("116394299154002", 0.28)

local function PlayPool(pool, key, vol)
    local idx = (State.PoolIndex[key] or 0) % POOL_N + 1
    State.PoolIndex[key] = idx
    local s = pool[idx]; if not s then return end
    s.Volume = vol; s.TimePosition = 0
    pcall(function() s:Play() end)
end

local lastClick = 0
local function PlayClick()
    local now = tick(); if now - lastClick < 0.04 then return end; lastClick = now
    PlayPool(ClickPool, "ck", 0.28)
end

local function PlayHit()
    if not F.HitsoundOn then return end
    local now = tick(); if now - State.LastHit < 0.05 then return end
    State.LastHit = now
    PlayPool(HitPool, "ht", F.HitsoundVol / 100)
    State.HitMarkerTime = tick()
end

