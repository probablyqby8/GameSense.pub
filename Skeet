-- ====================================================================
-- HITSOUND FIX
-- ====================================================================
local HITSOUND_WIN = 0.3
local LastHP = {}

local function HookPlayer(pl)
    if pl == LP then return end
    local function Attach(char)
        local hum = char:WaitForChild("Humanoid", 6); if not hum then return end
        LastHP[pl] = hum.Health
        local conn = hum.HealthChanged:Connect(function(newHP)
            if State.Destroyed then return end
            local dmg = (LastHP[pl] or newHP) - newHP
            LastHP[pl] = newHP
            if dmg <= 0 then return end
            
            local timeSinceFire = tick() - State.LastFire
            if timeSinceFire > HITSOUND_WIN then return end
            
            local headPos = char:FindFirstChild("Head") and char.Head.Position or char:FindFirstChild("HumanoidRootPart").Position
            local sp, onScreen = Camera:WorldToViewportPoint(headPos)
            if not onScreen then return end
            
            local vp = Camera.ViewportSize
            local crosshair = Vector2.new(vp.X/2, vp.Y/2)
            local dist = (Vector2.new(sp.X, sp.Y) - crosshair).Magnitude
            
            if dist > 250 then return end
            if not IsEnemy(pl) then return end
            
            PlayHit()
            if F.HitMarkers then
                Notify("hit", string.format("%s  -%d hp", pl.Name, math.floor(dmg)), 1.2, TH.AccentR)
            end
            if newHP <= 0 and F.KillNotif then
                Notify("killed", pl.DisplayName, 2, TH.AccentL)
            end
        end)
        table.insert(State.Connections, conn)
    end
    if pl.Character then task.spawn(Attach, pl.Character) end
    local rc = pl.CharacterAdded:Connect(function(c)
        if State.Destroyed then return end
        task.spawn(Attach, c)
    end)
    table.insert(State.Connections, rc)
end
for _, p in ipairs(Players:GetPlayers()) do HookPlayer(p) end
SaveConn(Players.PlayerAdded:Connect(function(p) if not State.Destroyed then HookPlayer(p) end end))

